<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every *Tests project gets the same test stack. -->
  <PropertyGroup Condition="'$(MSBuildProjectName.EndsWith(`Tests`))' == 'true'">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName.EndsWith(`Tests`))' == 'true'">
    <!-- xUnit v3 runs on Microsoft.Testing.Platform (opted in via global.json): no VSTest packages needed. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
